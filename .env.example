# Server deployments: variable names for /etc/sharakat/platform.env (values come
# from the secret manager; see docs/runbooks/deployment.md). Workstation installs
# don't need this file: the native runtime generates its own settings.
ENVIRONMENT=
DATABASE_URL=
STAGING_DATABASE_NAME=sharakat_staging
REDIS_URL=
SECRET_KEY=
PUBLIC_BASE_URL=
CORS_ORIGINS=
FORWARDED_ALLOW_IPS=127.0.0.1
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
DB_POOL_SIZE=
DB_MAX_OVERFLOW=
DB_POOL_TIMEOUT_SECONDS=
SLOW_QUERY_SECONDS=
SOURCE_JOB_TIMEOUT_SECONDS=
SOURCE_JOB_SOFT_TIMEOUT_SECONDS=
SOURCE_QUEUE_STALE_SECONDS=
BACKUP_DIR=/var/lib/sharakat/backups
ATTACHMENT_DIR=/var/lib/sharakat/attachments
BACKUP_RETAIN_DAILY=
BACKUP_RETAIN_WEEKLY=
BACKUP_RETAIN_MONTHLY=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=
ALERT_RECIPIENTS=
DEADLINE_ALERT_DAYS=30,14,7,3,1
DOCUMENT_COLLECTION_ENGINE_ENABLED=false
DOCUMENT_COLLECTION_MANUAL_ENABLED=false
DOCUMENT_COLLECTION_SCHEDULED_ENABLED=false
DOCUMENT_COLLECTION_STAGING_ENABLED=false
DOCUMENT_COLLECTION_AUTO_APPROVAL_ENABLED=false
DOCUMENT_COLLECTION_AUTO_PUBLICATION_ENABLED=false
