# The launcher creates .env.local with fresh local-only credentials.
# Copying this file manually is not required.
ENVIRONMENT=local_user
POSTGRES_DB=sharakat_local
POSTGRES_USER=sharakat_local
POSTGRES_PASSWORD=GENERATED_BY_START_PLATFORM
DATABASE_URL=postgresql+psycopg://sharakat_local:GENERATED_BY_START_PLATFORM@db:5432/sharakat_local
REDIS_PASSWORD=GENERATED_BY_START_PLATFORM
REDIS_URL=redis://:GENERATED_BY_START_PLATFORM@redis:6379/0
SECRET_KEY=GENERATED_BY_START_PLATFORM
PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
FORWARDED_ALLOW_IPS=172.31.240.10
COMPOSE_NETWORK_SUBNET=172.31.240.0/24
BOOTSTRAP_ADMIN_EMAIL=admin@local
BOOTSTRAP_ADMIN_PASSWORD=GENERATED_BY_START_PLATFORM
STAGING_DATABASE_NAME=sharakat_local
BACKUP_DIR=/backups
LOCAL_SQLITE_PATH=/source-data/al-ahsa-live.db
LOCAL_EXPECTED_DATABASE=sharakat_local
LOCAL_SETUP_MARKER=local_setup_state
